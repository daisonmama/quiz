<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>漢字プリント学習アプリ</title>
  <style>
    :root {
      --primary: #4a90e2;
      --success: #2ecc71;
      --danger: #e74c3c;
      --warning: #f39c12;
      --bg: #f8f9fa;
      --card-bg: #ffffff;
      --text: #333333;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 12px;
      display: flex;
      justify-content: center;
    }
    .container {
      width: 100%;
      max-width: 600px;
      background: var(--card-bg);
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
      padding: 20px;
      box-sizing: border-box;
    }
    h1 {
      font-size: 1.3rem;
      text-align: center;
      margin-top: 0;
      color: #2c3e50;
      border-bottom: 2px solid #edf2f7;
      padding-bottom: 10px;
    }
    .controls {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
      background: #f1f5f9;
      padding: 12px;
      border-radius: 10px;
    }
    .select-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    label {
      font-size: 0.85rem;
      font-weight: bold;
      color: #64748b;
    }
    select {
      padding: 10px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      font-size: 0.95rem;
      background: white;
    }
    .stats {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      color: #64748b;
      margin-bottom: 15px;
      background: #fff;
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
    }
    .quiz-card {
      background: #fff;
      border: 2px solid #e2e8f0;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 16px;
    }
    .question-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .badge {
      font-size: 0.75rem;
      padding: 4px 8px;
      border-radius: 12px;
      background: #e2e8f0;
      color: #475569;
      font-weight: bold;
    }
    .badge.wrong-count {
      background: #fee2e2;
      color: #dc2626;
    }
    .question-text {
      font-size: 1.1rem;
      line-height: 1.6;
      margin-bottom: 15px;
      font-weight: 500;
    }
    .ruby-target {
      color: var(--primary);
      font-weight: bold;
      border-bottom: 2px solid var(--primary);
      padding: 0 2px;
    }
    .input-section {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
    }
    input[type="text"] {
      flex: 1;
      padding: 10px 12px;
      border: 2px solid #cbd5e1;
      border-radius: 8px;
      font-size: 1rem;
      outline: none;
    }
    input[type="text"]:focus {
      border-color: var(--primary);
    }
    button {
      padding: 10px 16px;
      border: none;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn-submit {
      background: var(--primary);
      color: white;
    }
    .btn-next {
      background: var(--success);
      color: white;
      width: 100%;
      padding: 12px;
      font-size: 1rem;
    }
    .btn-reset {
      background: #ef4444;
      color: white;
      font-size: 0.8rem;
      padding: 6px 10px;
    }
    .feedback {
      margin-top: 10px;
      padding: 10px;
      border-radius: 8px;
      font-weight: bold;
      display: none;
    }
    .feedback.correct {
      background: #dcfce7;
      color: #15803d;
      border: 1px solid #bbf7d0;
    }
    .feedback.incorrect {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }
    .choice-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      margin-bottom: 12px;
    }
    .choice-btn {
      background: #f8fafc;
      border: 2px solid #e2e8f0;
      padding: 10px;
      border-radius: 8px;
      text-align: center;
      font-size: 1rem;
      cursor: pointer;
    }
    .choice-btn:hover {
      background: #edf2f7;
    }
    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>

<div class="container">
  <h1>漢字プリント学習アプリ</h1>

  <div class="controls">
    <div class="select-group">
      <label for="print-select">プリント選択:</label>
      <select id="print-select" onchange="initQuiz()">
        <option value="6">プリント ⑥</option>
        <!-- 今後 プリント 1〜5, 7〜39 をここに追加できます -->
      </select>
    </div>

    <div class="select-group">
      <label for="mode-select">出題モード:</label>
      <select id="mode-select" onchange="initQuiz()">
        <option value="all">すべての問題</option>
        <option value="wrong1">間違えた問題（1回以上）</option>
        <option value="wrong2">繰り返し間違えた問題（2回以上）</option>
        <option value="all-prints-wrong">全プリントの間違えた問題</option>
      </select>
    </div>
  </div>

  <div class="stats">
    <div>残り: <span id="remaining-count">0</span> 問</div>
    <div>累計ミス数: <span id="total-wrong">0</span> 次</div>
    <button class="btn-reset" onclick="resetHistory()">全履歴リセット</button>
  </div>

  <div id="quiz-area">
    <div class="quiz-card" id="card">
      <div class="question-header">
        <span class="badge" id="section-title">【1】カタカナを漢字に直す</span>
        <span class="badge wrong-count" id="item-wrong-badge">ミス: 0回</span>
      </div>
      
      <div class="question-text" id="question-text">問題文がここに表示されます</div>

      <!-- 記述入力式 -->
      <div class="input-section" id="text-input-group">
        <input type="text" id="answer-input" placeholder="漢字を入力..." autocomplete="off">
        <button class="btn-submit" onclick="checkAnswer()">判定</button>
      </div>

      <!-- 選択肢式（2, 3用） -->
      <div class="choice-grid hidden" id="choice-group"></div>

      <div class="feedback" id="feedback"></div>
    </div>

    <button class="btn-next hidden" id="next-btn" onclick="nextQuestion()">次の問題へ</button>
  </div>

  <div id="completion-message" class="hidden" style="text-align: center; padding: 30px 10px;">
    <h2>🎉 お疲れ様でした！</h2>
    <p id="completion-text">このモードの問題をすべて解き明かしました。</p>
    <button class="btn-submit" onclick="initQuiz()">もう一度挑戦する</button>
  </div>
</div>

<script>
// 問題データ構造（プリント⑥全問）
const quizData = {
  "6": [
    // 【1】カタカナを漢字に直す (全16問)
    { id: "6-1-1", section: "1", text: "チェスイ工事が行われる。", target: "チェスイ", answer: "治水", type: "text" },
    { id: "6-1-2", section: "1", text: "父はヨウシュが好きだと言っても、たしなむ程度だ。", target: "ヨウシュ", answer: "洋酒", type: "text" },
    { id: "6-1-3", section: "1", text: "手続きにはジツインが必要です。", target: "ジツイン", answer: "実印", type: "text" },
    { id: "6-1-4", section: "1", text: "けがのコウミョウで勝ってしまった。", target: "コウミョウ", answer: "功名", type: "text" },
    { id: "6-1-5", section: "1", text: "レッドクリフはジジツをもとにした映画だ。", target: "ジジツ", answer: "事実", type: "text" },
    { id: "6-1-6", section: "1", text: "おじは商売でセイケイを立てている。", target: "セイケイ", answer: "生計", type: "text" },
    { id: "6-1-7", section: "1", text: "東日本のホウゲンを学ぶ。", target: "ホウゲン", answer: "方言", type: "text" },
    { id: "6-1-8", section: "1", text: "パーティーにはレイフクで出席する。", target: "レイフク", answer: "礼服", type: "text" },
    { id: "6-1-9", section: "1", text: "シュクチョクの警備員がいるはずだ。", target: "シュクチョク", answer: "宿直", type: "text" },
    { id: "6-1-10", section: "1", text: "ショヨウのため来週の会議は欠席します。", target: "ショヨウ", answer: "所用", type: "text" },
    { id: "6-1-11", section: "1", text: "植物のセイチョウ記録をつける。", target: "セイチョウ", answer: "生長", type: "text" },
    { id: "6-1-12", section: "1", text: "先制打にチームのシキが上がる。", target: "シキ", answer: "士気", type: "text" },
    { id: "6-1-13", section: "1", text: "伝統芸能にイッカゲン持っている人。", target: "イッカゲン", answer: "一家言", type: "text" },
    { id: "6-1-14", section: "1", text: "近所のショウテンガイに買い物に行く。", target: "ショウテンガイ", answer: "商店街", type: "text" },
    { id: "6-1-15", section: "1", text: "仕事の途中でショウキュウシする。", target: "ショウキュウシ", answer: "小休止", type: "text" },
    { id: "6-1-16", section: "1", text: "ダイロッカンでそれがそうだとわかった。", target: "ダイロッカン", answer: "第六感", type: "text" },

    // 【2】□頭にあてはまる漢字 (全14問)
    { id: "6-2-1", section: "2", text: "この大会の優勝候補の□頭にあげられるチームだ。", answer: "筆", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-2", section: "2", text: "□頭では新聞の号外が配られているようだ。", answer: "街", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-3", section: "2", text: "そんなことをする気は□頭ありませんでした。", answer: "毛", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-4", section: "2", text: "くれぐれも自分の立場を□頭に置いておくように。", answer: "念", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-5", section: "2", text: "書面は配らず、□頭で説明することにした。", answer: "口", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-6", section: "2", text: "このまま借金がかさめば、一家は□頭に迷うことになる。", answer: "路", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-7", section: "2", text: "本当にこいつは話のわからない□頭だな。", answer: "石", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-8", section: "2", text: "この旅館の□頭さんは働き者で有名だ。", answer: "番", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-9", section: "2", text: "□頭のカラーページにのっている懸賞に応募する。", answer: "巻", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-10", section: "2", text: "新しい勢力が□頭してきたのはこの頃だ。", answer: "台", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-11", section: "2", text: "三十キロを過ぎても、□頭集団はかたまかったままだ。", answer: "先", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-12", section: "2", text: "乾杯の□頭は支店長にお願いすることにしました。", answer: "音", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-13", section: "2", text: "その恐慌がおこったのは二十世紀□頭のことだった。", answer: "初", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-2-14", section: "2", text: "この事件がやつの仕業とわかり、怒り□頭に発する。", answer: "心", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },

    // 【3】□首にあてはまる漢字 (全10問)
    { id: "6-3-1", section: "3", text: "犯人の□首によって事件は解決した。", answer: "自", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-3-2", section: "3", text: "姉は大学を□首で卒業した。", answer: "都", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-3-3", section: "3", text: "オーストラリアの□首はキャンベラだ。", answer: "首", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-3-4", section: "3", text: "首相は次の選挙の時期をほのめかした。", answer: "相", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-3-5", section: "3", text: "イチローは七年連続で□首打者となった。", answer: "位", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-3-6", section: "3", text: "容疑者の首実検をするそうだ。", answer: "検", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-3-7", section: "3", text: "派遣社員の首切りに反対する運動がおきている。", answer: "切", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-3-8", section: "3", text: "ついに相手の首っ根をおさえることができた。", answer: "根", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-3-9", section: "3", text: "辞書を首っ引きで原稿を読む。", answer: "引", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] },
    { id: "6-3-10", section: "3", text: "首の皮一枚で予選落ちをまぬがれることができた。", answer: "皮", choices: ["イ","カワ","キ","ケン","ジ","ショウ","セキ","ト","ネ","ビ"] }
  ]
};

// ローカルストレージキー
const STORAGE_KEY = 'kanji_quiz_records_v1';

// 状態変数
let currentList = [];
let currentIndex = 0;
let userRecords = loadRecords();

function loadRecords() {
  const data = localStorage.getItem(STORAGE_KEY);
  return data ? JSON.parse(data) : {};
}

function saveRecords() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(userRecords));
}

function getWrongCount(id) {
  return userRecords[id] ? userRecords[id].wrong : 0;
}

function initQuiz() {
  const printId = document.getElementById('print-select').value;
  const mode = document.getElementById('mode-select').value;
  
  let rawQuestions = [];
  
  if (mode === 'all-prints-wrong') {
    Object.keys(quizData).forEach(pId => {
      rawQuestions = rawQuestions.concat(quizData[pId]);
    });
  } else {
    rawQuestions = quizData[printId] || [];
  }

  // フィルタリング
  if (mode === 'wrong1') {
    currentList = rawQuestions.filter(q => getWrongCount(q.id) >= 1);
  } else if (mode === 'wrong2' || mode === 'all-prints-wrong') {
    currentList = rawQuestions.filter(q => getWrongCount(q.id) >= 2);
  } else {
    currentList = [...rawQuestions];
  }

  currentIndex = 0;
  
  if (currentList.length === 0) {
    document.getElementById('quiz-area').classList.add('hidden');
    document.getElementById('completion-message').classList.remove('hidden');
    document.getElementById('completion-text').innerText = "条件に該当する問題はありません！よく頑張りました！";
  } else {
    document.getElementById('quiz-area').classList.remove('hidden');
    document.getElementById('completion-message').classList.add('hidden');
    showQuestion();
  }

  updateStats();
}

function showQuestion() {
  const q = currentList[currentIndex];
  
  // セクション名
  let secTitle = "";
  if (q.section === "1") secTitle = "【1】漢字直す";
  if (q.section === "2") secTitle = "【2】□頭の漢字";
  if (q.section === "3") secTitle = "【3】□首の漢字";
  document.getElementById('section-title').innerText = secTitle;

  // ミス回数
  const wrongCnt = getWrongCount(q.id);
  const badge = document.getElementById('item-wrong-badge');
  badge.innerText = `ミス: ${wrongCnt}回`;
  badge.className = wrongCnt > 0 ? "badge wrong-count" : "badge";

  // 問題文の表示処理
  let textHtml = q.text;
  if (q.target) {
    textHtml = textHtml.replace(q.target, `<span class="ruby-target">${q.target}</span>`);
  }
  document.getElementById('question-text').innerHTML = textHtml;

  // 入力UIの切替
  const inputGroup = document.getElementById('text-input-group');
  const choiceGroup = document.getElementById('choice-group');
  const answerInput = document.getElementById('answer-input');

  answerInput.value = '';
  document.getElementById('feedback').classList.add('hidden');
  document.getElementById('next-btn').classList.add('hidden');

  if (q.type === 'text') {
    inputGroup.classList.remove('hidden');
    choiceGroup.classList.add('hidden');
    answerInput.focus();
  } else {
    inputGroup.classList.add('hidden');
    choiceGroup.classList.remove('hidden');
    
    // 選択肢（記述式でも解けるように漢字のまま入力か、一般的な漢字キーを表示）
    // 大問2・3は漢字入力または選択できるようにボタン配置
    choiceGroup.innerHTML = '';
    // 代表的な解答候補などをボタンとして表示
    const candidates = getCandidatesForSection(q.section);
    candidates.forEach(kanji => {
      const btn = document.createElement('button');
      btn.className = 'choice-btn';
      btn.innerText = kanji;
      btn.onclick = () => checkChoiceAnswer(kanji);
      choiceGroup.appendChild(btn);
    });
  }

  updateStats();
}

// 大問2・3用の候補漢字リスト
function getCandidatesForSection(section) {
  if (section === "2") {
    return ["筆", "街", "毛", "念", "口", "路", "石", "番", "巻", "台", "先", "音", "初", "心"];
  } else {
    return ["自", "都", "首", "相", "位", "検", "切", "根", "引", "皮"];
  }
}

function checkAnswer() {
  const q = currentList[currentIndex];
  const userAns = document.getElementById('answer-input').value.trim();
  processResult(userAns === q.answer, q.answer);
}

function checkChoiceAnswer(selectedKanji) {
  const q = currentList[currentIndex];
  processResult(selectedKanji === q.answer, q.answer);
}

function processResult(isCorrect, correctAnswer) {
  const q = currentList[currentIndex];
  const feedback = document.getElementById('feedback');
  
  if (!userRecords[q.id]) {
    userRecords[q.id] = { wrong: 0, correct: 0 };
  }

  feedback.classList.remove('hidden', 'correct', 'incorrect');

  if (isCorrect) {
    feedback.classList.add('correct');
    feedback.innerText = "⭕ 正解！";
    userRecords[q.id].correct += 1;
  } else {
    feedback.classList.add('incorrect');
    feedback.innerText = `❌ 不正解... 正解は【 ${correctAnswer} 】です`;
    userRecords[q.id].wrong += 1;
  }

  saveRecords();
  updateStats();

  document.getElementById('next-btn').classList.remove('hidden');
}

function nextQuestion() {
  currentIndex++;
  if (currentIndex >= currentList.length) {
    document.getElementById('quiz-area').classList.add('hidden');
    document.getElementById('completion-message').classList.remove('hidden');
    document.getElementById('completion-text').innerText = "すべての問題を解き終えました！";
  } else {
    showQuestion();
  }
}

function updateStats() {
  const remaining = currentList.length - currentIndex;
  document.getElementById('remaining-count').innerText = remaining < 0 ? 0 : remaining;

  let totalWrong = 0;
  Object.keys(userRecords).forEach(id => {
    totalWrong += userRecords[id].wrong || 0;
  });
  document.getElementById('total-wrong').innerText = totalWrong;
}

function resetHistory() {
  if (confirm("これまでの解答履歴（間違えた記録）をすべて消去しますか？")) {
    localStorage.removeItem(STORAGE_KEY);
    userRecords = {};
    initQuiz();
  }
}

// 初期化
window.onload = initQuiz;
</script>

</body>
</html>
